{
    "name": "textract-pipeline",
    "version": "1.0.0",
    "description": "Textract trigger + processor lambdas — ingestion pipeline stage 2",
    "type": "module",
    "scripts": {
      "package:trigger":   "zip -r textract-trigger.zip src/ package.json",
      "package:processor": "zip -r textract-processor.zip src/ package.json",
      "package:all":       "npm run package:trigger && npm run package:processor"
    },
    "dependencies": {
      "@aws-sdk/client-dynamodb":  "^3.600.0",
      "@aws-sdk/client-s3":        "^3.600.0",
      "@aws-sdk/client-sqs":       "^3.600.0",
      "@aws-sdk/client-textract":  "^3.600.0",
      "@aws-sdk/util-dynamodb":    "^3.600.0"
    }
  }